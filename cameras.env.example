# The cameras this box records, one line each.
#
# CAM_<name>=<rtsp url>
#
# The name becomes the S3 prefix, so it must match what the AI worker looks for:
# {court}_{cam}. A court has two cameras at opposite ends; the worker fuses them, and its
# baked court geometry is keyed by these exact names. So name them court<N>_cam<M>, never
# left/right: the analysis reads court1_cam5 and court1_cam13, and footage under any other
# prefix is invisible to it. Renaming a camera later splits its footage across two prefixes.
#
# Cameras on their own PoE switch, reachable directly:
#   CAM_court1_cam5=rtsp://viewer:PASSWORD@<camera-ip>:554/media/video1
#
# Cameras on the NVR's PoE ports, so only the NVR can see them. Pull the channel off the NVR
# instead. c1 is channel 1, c2 is channel 2, s0 is the main stream.
#   CAM_court1_cam5=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c1/s0/live
#
# Always the main stream (s0), never the sub stream: the sub stream is a low resolution
# preview and is useless as training data.

CAM_court1_cam5=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c1/s0/live
CAM_court1_cam13=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c2/s0/live

# Where booked footage goes. This bucket has no lifecycle rule, unlike the media bucket the
# product uses, whose frames are deleted after 48 hours.
S3_BUCKET=padelytix-training-<account-id>

# Which venue this box records. The box asks the app which windows are booked on this venue
# and keeps only that footage; everything outside a booking is deleted, never uploaded. Find
# the id in the admin console.
VENUE_ID=1

# How the box reaches the app to fetch the booking plan, and the shared secret it signs that
# request with (the same camera secret the heartbeat uses, PDX_CAMERA_HMAC_SECRET on the API).
PDX_API_BASE_URL=https://api.padelytix.com
CAMERA_HMAC_SECRET=REPLACE_ME

# The recording window, local time. ffmpeg records continuously across this window; the sync
# step is what keeps only booked footage. Cover all bookable hours here. Set in the timers,
# see README.
