# The cameras this box records, one line each.
#
# CAM_<name>=<rtsp url>
#
# The name becomes the S3 prefix, so keep it meaningful and stable. Renaming a
# camera later splits its footage across two prefixes in the training set.
#
# Cameras on their own PoE switch, reachable directly:
#   CAM_court1_left=rtsp://viewer:PASSWORD@<camera-ip>:554/media/video1
#
# Cameras on the NVR's PoE ports, so only the NVR can see them. Pull the channel
# off the NVR instead. c1 is channel 1, c2 is channel 2, s0 is the main stream.
#   CAM_court1_left=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c1/s0/live
#
# Always the main stream (s0), never the sub stream: the sub stream is a low
# resolution preview and is useless as training data.

CAM_court1_left=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c1/s0/live
CAM_court1_right=rtsp://viewer:PASSWORD@<nvr-ip>:554/unicast/c2/s0/live

# Where the footage goes. This bucket has no lifecycle rule, unlike the media
# bucket the product uses, whose frames are deleted after 48 hours.
S3_BUCKET=padelytix-training

# The recording window, local time. Matches run 19:00 to 00:00.
# Changing these means editing the systemd timers too, see README.
