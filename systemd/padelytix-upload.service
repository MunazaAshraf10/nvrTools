[Unit]
Description=Drain finished footage segments to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/padelytix/upload.sh
User=padelytix
Group=padelytix
StateDirectory=padelytix

# Point the AWS CLI at an explicit path rather than letting it guess from $HOME.
#
# systemd sets $HOME from the passwd entry, so if a human user named padelytix
# already exists on the box, HOME is /home/padelytix and the CLI looks there,
# not in the /var/lib/padelytix the provisioner set up. The upload then fails
# with "unable to locate credentials" while recording carries on happily, which
# is the worst shape of failure: footage piling up on a disk and nothing in S3.
#
# Naming the file removes the guess.
Environment=AWS_SHARED_CREDENTIALS_FILE=/var/lib/padelytix/.aws/credentials
Environment=AWS_CONFIG_FILE=/var/lib/padelytix/.aws/config
